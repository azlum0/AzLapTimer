{
  "name": "lap-timer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:device": "vite --mode device",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extension.json",
    "preview": "vite preview",
    "push": "bun scripts/push.ts",
    "share": "bun scripts/share.ts",
    "update": "bunx @bridgething/updater",
    "test": "bun test",
    "probe": "deno run --allow-ffi --allow-net=127.0.0.1:8765 extension/probe.ts",
    "deploy": "bun scripts/deploy.ts"
  },
  "dependencies": {
    "@bridgething/client": "^0.12.1",
    "@bridgething/extension": "^0.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/deno": "^2.7.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "2.9.6",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
